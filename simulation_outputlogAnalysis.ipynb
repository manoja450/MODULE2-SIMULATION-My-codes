#!/usr/bin/env python
import re, sys, os, subprocess
import numpy as np
import matplotlib.pyplot as plt
from collections import defaultdict
from mpl_toolkits.mplot3d import Axes3D
from matplotlib.patches import Patch

LOG_FILE = "simulation_output_run11.log"

# ------------------------------------------------------------------
# FIXED DETECTOR / GENERATOR CONSTANTS
CENTER_X = 0.0
CENTER_Y = 110.73384
CENTER_Z = -80.74526
CENTER = (CENTER_X, CENTER_Y, CENTER_Z)

D2O_RADIUS = 33.655
D2O_HALF_HEIGHT = 67.4624
GENERATOR_Z_HALF = 89.9275

ACRYLIC_THICKNESS = 0.5 * 2.54
ACRYLIC_RADIUS = D2O_RADIUS + ACRYLIC_THICKNESS
ACRYLIC_ENDCAP_THICKNESS = 1.0 * 2.54

H2O_RADIUS = 44.45
H2O_HALF_HEIGHT = (75.55 - 0.5) * 2.54 / 2.0

STEEL_RADIUS = H2O_RADIUS + 0.25 * 2.54
STEEL_HALF_HEIGHT = H2O_HALF_HEIGHT + 0.25 * 2.54 / 2.0

# ------------------------------------------------------------------
# ROBUST FLOAT REGEX
FLOAT_RE = r'([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)'

# ------------------------------------------------------------------
# CORRECTED SEQUENTIAL PARSER
def parse_capture_events(lines):
    events = []
    i = 0
    total = len(lines)

    while i < total:
        line = lines[i]

        if 'Particle = neutron' in line and 'Parent ID = 0' in line:
            # Find Step# header
            i += 1
            while i < total and 'Step#' not in lines[i]:
                i += 1

            # Read Step 0
            i += 1
            while i < total and lines[i].strip() == '':
                i += 1

            init_pos = None
            if i < total:
                step0 = lines[i]
                m = re.match(rf'^\s*0\s+{FLOAT_RE}\s+{FLOAT_RE}\s+{FLOAT_RE}', step0)
                if m:
                    x_mm = float(m.group(1))
                    y_mm = float(m.group(2))
                    z_mm = float(m.group(3))
                    init_pos = (x_mm / 10.0, y_mm / 10.0, z_mm / 10.0)

            cap_pos = None
            volume = None
            j = i
            while j < total:
                l = lines[j]
                if cap_pos is None and ('nCaptureHP' in l or 'nCapture' in l):
                    m = re.match(rf'^\s*\d+\s+{FLOAT_RE}\s+{FLOAT_RE}\s+{FLOAT_RE}', l)
                    v = re.search(r'\s+(\w+PhysV)\s+', l)
                    if m and v:
                        cap_pos = (float(m.group(1))/10.0,
                                   float(m.group(2))/10.0,
                                   float(m.group(3))/10.0)
                        volume = v.group(1)
                if 'Particle = neutron' in l and 'Parent ID = 0' in l:
                    break
                j += 1

            i = j
            if cap_pos is not None and volume is not None:
                if init_pos is None:
                    init_pos = cap_pos
                events.append({
                    'init_pos_cm': init_pos,
                    'cap_pos_cm': cap_pos,
                    'volume': volume,
                })
        else:
            i += 1

    return events

# ------------------------------------------------------------------
# DRAW CYLINDER SURFACE
def draw_cylinder_surface(ax, radius_cm, half_height_cm, color='gray', alpha=0.05, linewidth=0):
    r_m = radius_cm / 100.0
    h_m = half_height_cm / 100.0
    theta = np.linspace(0, 2*np.pi, 40)
    zline = np.linspace(-h_m, h_m, 20)
    Theta, Z = np.meshgrid(theta, zline)
    X = r_m * np.cos(Theta)
    Y = r_m * np.sin(Theta)
    ax.plot_surface(X, Y, Z, color=color, alpha=alpha, linewidth=linewidth)

# ------------------------------------------------------------------
# PLOTTING – 3D and 2D projections (legend very tight)
def plot_positions(events, kind='initial', title_suffix=''):
    if kind == 'initial':
        pts = [(e['init_pos_cm'][0]-CENTER_X, e['init_pos_cm'][1]-CENTER_Y, e['init_pos_cm'][2]-CENTER_Z) for e in events]
        title = 'Primary Neutron Initial Positions'
        fname = f'fig1_initial{title_suffix}'
        color = '#8B4513'
        s = 1
        alpha = 0.08
    else:
        pts = [(e['cap_pos_cm'][0]-CENTER_X, e['cap_pos_cm'][1]-CENTER_Y, e['cap_pos_cm'][2]-CENTER_Z) for e in events]
        title = 'Neutron Capture Locations'
        fname = f'fig2_captures{title_suffix}'
        vol_colors = {
            'd2oPhysV': '#2C3E50', 'h2oPhysV': '#E74C3C',
            'acrylicPhysV': '#2ECC71', 'outerVesselPhysV': '#95A5A6',
            'shieldingPhysV': '#F39C12', 'tyvekPhysV': '#9B59B6',
            'basePlatePhysV': '#8E44AD', 'narrowVetoPhysV': '#1ABC9C'
        }
        color = [vol_colors.get(e['volume'], '#7F8C8D') for e in events]
        s = 3
        alpha = 0.15

    x = [p[0]/100.0 for p in pts]
    y = [p[1]/100.0 for p in pts]
    z = [p[2]/100.0 for p in pts]

    r_m = STEEL_RADIUS / 100.0
    z_half = GENERATOR_Z_HALF / 100.0

    # ---- 3D figure ----
    fig = plt.figure(figsize=(14, 10))
    ax = fig.add_subplot(111, projection='3d')

    draw_cylinder_surface(ax, D2O_RADIUS, D2O_HALF_HEIGHT, color='blue', alpha=0.05)
    draw_cylinder_surface(ax, ACRYLIC_RADIUS, D2O_HALF_HEIGHT + ACRYLIC_ENDCAP_THICKNESS,
                          color='magenta', alpha=0.03)
    draw_cylinder_surface(ax, H2O_RADIUS, H2O_HALF_HEIGHT, color='cyan', alpha=0.03)
    draw_cylinder_surface(ax, STEEL_RADIUS, STEEL_HALF_HEIGHT, color='gray', alpha=0.03)

    if kind == 'initial':
        ax.scatter(x, y, z, s=s, color=color, alpha=alpha)
    else:
        ax.scatter(x, y, z, s=s, c=color, alpha=alpha, edgecolors='none')
        unique_vols = list(set(e['volume'] for e in events))
        handles = [Patch(color=vol_colors.get(v, '#7F8C8D'), label=v) for v in unique_vols if v in vol_colors]
        if handles:
            # Legend very close to the axes
            ax.legend(handles=handles, loc='center left', bbox_to_anchor=(0.97, 0.5),
                      borderaxespad=0.0, frameon=True, framealpha=0.95,
                      fancybox=False, edgecolor='black', fontsize=10, title='Capture Volume')

    ax.set_box_aspect((2*r_m, 2*r_m, 2*z_half))
    ax.set_xlim(-r_m*1.05, r_m*1.05)
    ax.set_ylim(-r_m*1.05, r_m*1.05)
    ax.set_zlim(-z_half*1.05, z_half*1.05)

    ax.set_xlabel(r'$x$ (m)', fontweight='bold')
    ax.set_ylabel(r'$y$ (m)', fontweight='bold')
    ax.set_zlabel(r'$z$ (m)', fontweight='bold')
    ax.set_title(title, pad=25, fontweight='bold')
    ax.view_init(elev=28, azim=-60)

    ax.grid(True, linestyle='--', alpha=0.3)
    ax.minorticks_on()
    ax.tick_params(which='both', direction='in', top=True, right=True)

    plt.tight_layout()
    plt.savefig(f'{fname}_3d.png', dpi=300, bbox_inches='tight')
    plt.show()
    print(f"✓ Saved {fname}_3d.png")

    # ---- 2D projections ----
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    plt.subplots_adjust(wspace=0.15)

    handles = None
    if kind != 'initial':
        unique_vols = list(set(e['volume'] for e in events))
        handles = [Patch(color=vol_colors.get(v, '#7F8C8D'), label=v) for v in unique_vols if v in vol_colors]

    for ax, (xdata, ydata, xlab, ylab) in zip(axes,
                                               [(x, y, 'x', 'y'), (x, z, 'x', 'z'), (y, z, 'y', 'z')]):
        if kind == 'initial':
            ax.scatter(xdata, ydata, s=s, color=color, alpha=alpha)
        else:
            ax.scatter(xdata, ydata, s=s, c=color, alpha=alpha, edgecolors='none')
        ax.set_xlabel(f'{xlab} (m)')
        ax.set_ylabel(f'{ylab} (m)')
        ax.set_title(f'{xlab}{ylab} Projection')
        ax.set_aspect('equal')
        ax.grid(True, alpha=0.3)

    if kind != 'initial' and handles:
        fig.legend(handles=handles, loc='center right', bbox_to_anchor=(0.97, 0.5),
                   borderaxespad=0.0, frameon=True, framealpha=0.95,
                   fancybox=False, edgecolor='black', fontsize=10, title='Capture Volume')

    plt.tight_layout(rect=[0, 0, 0.78, 1])
    plt.savefig(f'{fname}_2d.png', dpi=300, bbox_inches='tight')
    plt.show()
    print(f"✓ Saved {fname}_2d.png")

# ------------------------------------------------------------------
# ADDITIONAL PHYSICS PLOTS
def plot_capture_fraction_vs_radius(events):
    """Capture fraction vs initial cylindrical radius."""
    radii = np.array([np.sqrt((e['init_pos_cm'][0]-CENTER_X)**2 +
                             (e['init_pos_cm'][1]-CENTER_Y)**2) for e in events])

    bin_edges = np.array([0, 5, 10, 15, 20, 25, 30, 35])
    bin_centers = 0.5 * (bin_edges[:-1] + bin_edges[1:])
    n_bins = len(bin_edges) - 1

    volumes = list(set(e['volume'] for e in events))
    bin_counts = {vol: [0]*n_bins for vol in volumes}
    bin_totals = [0]*n_bins

    for e, r in zip(events, radii):
        for b in range(n_bins):
            if bin_edges[b] <= r < bin_edges[b+1] or (b == n_bins-1 and r >= bin_edges[-1]):
                bin_totals[b] += 1
                bin_counts[e['volume']][b] += 1
                break

    vol_list = ['d2oPhysV', 'h2oPhysV', 'acrylicPhysV']
    other_counts = [0]*n_bins
    for vol in volumes:
        if vol not in vol_list:
            for b in range(n_bins):
                other_counts[b] += bin_counts[vol][b]
    vol_list.append('Other')
    bin_counts['Other'] = other_counts

    colors = {'d2oPhysV': '#2C3E50', 'h2oPhysV': '#E74C3C',
              'acrylicPhysV': '#2ECC71', 'Other': '#95A5A6'}
    labels = {'d2oPhysV': 'D₂O', 'h2oPhysV': 'H₂O',
              'acrylicPhysV': 'Acrylic', 'Other': 'Other'}

    fig, ax = plt.subplots(figsize=(12.8, 6.2))

    for vol in vol_list:
        frac = []
        err = []
        for b in range(n_bins):
            total = bin_totals[b]
            if total == 0:
                frac.append(0.0)
                err.append(0.0)
            else:
                c = bin_counts[vol][b]
                f = c / total
                e = np.sqrt(f*(1-f)/total) if 0 < f < 1 else 0.0
                frac.append(f)
                err.append(e)

        mask = np.array(bin_totals) > 0
        if np.sum(mask) == 0:
            continue
        ax.errorbar(bin_centers[mask], np.array(frac)[mask]*100,
                    yerr=np.array(err)[mask]*100,
                    color=colors.get(vol, 'gray'), marker='o', markersize=8,
                    capsize=5, capthick=2, elinewidth=1.5,
                    label=labels.get(vol, vol), linewidth=2)

    ax.axvline(D2O_RADIUS, color='blue', linestyle='--', alpha=0.5, linewidth=1.5, label='D₂O boundary')
    ax.axvline(H2O_RADIUS, color='green', linestyle='--', alpha=0.5, linewidth=1.5, label='H₂O boundary')

    ax.set_xlabel('Initial Cylindrical Radius (cm)', fontweight='bold')
    ax.set_ylabel('Capture Fraction (%)', fontweight='bold')
    ax.set_title('Neutron Capture Fraction vs Initial Radius', pad=15, fontweight='bold')
    ax.set_xlim(0, 35)
    ax.set_ylim(0, 105)
    ax.legend(loc='upper right', frameon=True, framealpha=0.95, fancybox=False, edgecolor='black')
    ax.grid(True, linestyle='--', alpha=0.3)
    ax.minorticks_on()
    ax.tick_params(which='both', direction='in', top=True, right=True)

    plt.tight_layout()
    plt.savefig('capture_fraction_vs_radius.png', dpi=300, bbox_inches='tight')
    plt.show()
    print("✓ Saved: capture_fraction_vs_radius.png")

def plot_initial_radius_distribution(events):
    """Histogram of initial cylindrical radii – no vertical lines."""
    radii = np.array([np.sqrt((e['init_pos_cm'][0]-CENTER_X)**2 +
                             (e['init_pos_cm'][1]-CENTER_Y)**2) for e in events])

    fig, ax = plt.subplots(figsize=(12.8, 6.2))

    ax.hist(radii, bins=50, alpha=0.5, color='#2C3E50', histtype='stepfilled',
            edgecolor='black', label='Initial Radii')

    # No vertical lines – removed

    ax.set_xlabel('Initial Cylindrical Radius (cm)', fontweight='bold')
    ax.set_ylabel('Counts', fontweight='bold')
    ax.set_title('Initial Neutron Radius Distribution', pad=15, fontweight='bold')
    ax.legend()
    ax.grid(True, linestyle='--', alpha=0.3)
    ax.minorticks_on()
    ax.tick_params(which='both', direction='in', top=True, right=True)

    plt.tight_layout()
    plt.savefig('initial_radius_distribution.png', dpi=300, bbox_inches='tight')
    plt.show()
    print("✓ Saved: initial_radius_distribution.png")

def plot_neutron_displacement(events):
    """Histogram of neutron displacement – no vertical lines."""
    displacements = []
    for e in events:
        dx = e['cap_pos_cm'][0] - e['init_pos_cm'][0]
        dy = e['cap_pos_cm'][1] - e['init_pos_cm'][1]
        dz = e['cap_pos_cm'][2] - e['init_pos_cm'][2]
        displ = np.sqrt(dx*dx + dy*dy + dz*dz) * 10.0  # cm -> mm
        displacements.append(displ)

    displacements = np.array(displacements)

    fig, ax = plt.subplots(figsize=(12.8, 6.2))

    bin_width_mm = 10
    bins_mm = np.arange(0, max(displacements) + bin_width_mm, bin_width_mm)

    hist, bin_edges = np.histogram(displacements, bins=bins_mm)
    bin_centers = 0.5 * (bin_edges[:-1] + bin_edges[1:])

    x = []
    y = []
    for i in range(len(bin_edges) - 1):
        x.append(bin_edges[i])
        x.append(bin_edges[i+1])
        y.append(hist[i])
        y.append(hist[i])
    x = np.concatenate([[bin_edges[0]], x, [bin_edges[-1]]])
    y = np.concatenate([[0], y, [0]])

    ax.plot(x, y, color='#2C3E50', linewidth=1.5, drawstyle='steps-post',
            label=f'Neutron Displacement (N={len(displacements):,})')
    ax.plot(bin_centers, hist, 'o', color='#2C3E50', markersize=4,
            markerfacecolor='white', markeredgecolor='#2C3E50', markeredgewidth=1.2)

    # Removed vertical dashed lines for mean and median

    ax.set_xlabel('Displacement (mm)', fontweight='bold')
    ax.set_ylabel(f'Counts / {bin_width_mm} mm', fontweight='bold')
    ax.set_title('Neutron Displacement: Production to Capture', pad=15, fontweight='bold')
    ax.legend()
    ax.grid(True, linestyle='--', alpha=0.3)
    ax.minorticks_on()
    ax.tick_params(which='both', direction='in', top=True, right=True)

    plt.tight_layout()
    plt.savefig('neutron_displacement.png', dpi=300, bbox_inches='tight')
    plt.show()
    print("✓ Saved: neutron_displacement.png")

# ------------------------------------------------------------------
# MAIN
def main():
    if not os.path.exists(LOG_FILE):
        print(f"ERROR: {LOG_FILE} not found!")
        return

    try:
        n_cap = int(subprocess.check_output(f"grep -c nCaptureHP {LOG_FILE}", shell=True).strip())
    except:
        n_cap = None

    with open(LOG_FILE, 'r') as f:
        lines = f.readlines()

    events = parse_capture_events(lines)
    parsed_cap = len(events)

    print("="*60)
    print("PARSER STATISTICS")
    print("="*60)
    if n_cap is not None:
        print(f"Capture events (grep -c nCaptureHP) : {n_cap}")
    print(f"Capture events (parsed)              : {parsed_cap}")
    if n_cap is not None and parsed_cap != n_cap:
        print(f"⚠️ WARNING: Capture count mismatch! Missing {n_cap - parsed_cap} captures.")
    else:
        print("✓ Capture count matches.")

    if parsed_cap == 0:
        return

    # ---- Radius check ----
    radii = np.array([np.sqrt((e['init_pos_cm'][0]-CENTER_X)**2 +
                             (e['init_pos_cm'][1]-CENTER_Y)**2) for e in events])
    outside = np.sum(radii > D2O_RADIUS)
    print(f"\nRadius violations (> {D2O_RADIUS} cm): {outside} / {parsed_cap}")
    if outside > 0:
        print("Worst offenders:")
        idx = np.where(radii > D2O_RADIUS)[0]
        for i in idx[:10]:
            x, y, z = events[i]['init_pos_cm']
            r = np.sqrt((x-CENTER_X)**2 + (y-CENTER_Y)**2)
            print(f"  Event {i}: r = {r:.3f} cm   ({x:.1f}, {y:.1f}, {z:.1f})")

    # ---- Z range ----
    zrel = np.array([e['init_pos_cm'][2] - CENTER_Z for e in events])
    print(f"\nZ range (relative to centre): {np.min(zrel):.1f}  to  {np.max(zrel):.1f} cm")
    print(f"Generator expected: ±{GENERATOR_Z_HALF:.1f} cm")

    # ---- Generate all plots (no D₂O‑only) ----
    plot_positions(events, 'initial')
    plot_positions(events, 'capture')

    # Additional physics plots
    plot_capture_fraction_vs_radius(events)
    plot_initial_radius_distribution(events)
    plot_neutron_displacement(events)

    # ---- Volume counts ----
    vol_counts = defaultdict(int)
    for e in events:
        vol_counts[e['volume']] += 1
    print("\nCapture by volume:")
    for v, c in sorted(vol_counts.items(), key=lambda x: -x[1]):
        print(f"  {v:20s}: {c:6d} ({100*c/parsed_cap:5.1f}%)")

    # ---- Summary statistics ----
    displacements = []
    for e in events:
        dx = e['cap_pos_cm'][0] - e['init_pos_cm'][0]
        dy = e['cap_pos_cm'][1] - e['init_pos_cm'][1]
        dz = e['cap_pos_cm'][2] - e['init_pos_cm'][2]
        displacements.append(np.sqrt(dx*dx + dy*dy + dz*dz) * 10.0)

    print("\n" + "="*60)
    print("SUMMARY STATISTICS")
    print("="*60)
    print(f"Total captures: {len(events):,}")
    print(f"Mean initial cylindrical radius: {np.mean(radii):.1f} cm")
    print(f"Median initial cylindrical radius: {np.median(radii):.1f} cm")
    print(f"Mean displacement: {np.mean(displacements):.1f} mm")
    print(f"Median displacement: {np.median(displacements):.1f} mm")

    d2o_captures = sum(1 for e in events if e['volume'] == 'd2oPhysV')
    h2o_captures = sum(1 for e in events if e['volume'] == 'h2oPhysV')
    acrylic_captures = sum(1 for e in events if e['volume'] == 'acrylicPhysV')
    print(f"\nCaptures inside D₂O: {d2o_captures} ({100*d2o_captures/len(events):.1f}%)")
    print(f"Captures inside H₂O: {h2o_captures} ({100*h2o_captures/len(events):.1f}%)")
    print(f"Captures inside Acrylic: {acrylic_captures} ({100*acrylic_captures/len(events):.1f}%)")

    print("\n" + "="*60)
    print("ANALYSIS COMPLETE")
    print("="*60)

if __name__ == "__main__":
    main()
